# LinkToGlobe.ai — environment template.
# Copy to `.env` and fill in what you need locally. NEVER commit `.env`.
# Every value here is a placeholder. Do not paste real secrets into this file.
#
# Only DATABASE_URL and AUTH_SECRET are required. Every integration below is
# optional: the app runs fully without any of them, and each one shows a
# "Not configured" state until its variables are set.

# ─────────────────────────────────────────────────────────────────────────────
# Core (required)
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development

# Public base URL. Safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string.
#   npm run db:up  -> starts a portable local Postgres matching this default.
DATABASE_URL=postgresql://linktoglobe:linktoglobe@127.0.0.1:5432/linktoglobe?schema=public

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-64-char-hex-string

# Dev seed account created by `npm run db:seed`.
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me-locally

# ─────────────────────────────────────────────────────────────────────────────
# AI provider (optional)
#   manual    -> no API calls; you write everything yourself (default)
#   anthropic -> Anthropic API; requires AI_API_KEY
#   openai    -> OpenAI (ChatGPT) API; requires OPENAI_API_KEY
#   gemini    -> Google Gemini API;    requires GEMINI_API_KEY
# Set AI_MODEL to a model the chosen provider supports
# (e.g. claude-sonnet-5, gpt-4o, gemini-2.0-flash). Server-side only.
# Used for idea/hook/draft assistance and AI-assisted review.
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=manual
AI_MODEL=claude-sonnet-5
AI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Research / search provider (optional).
#   RESEARCH_PROVIDER=tavily  -> RESEARCH_API_KEY from https://tavily.com
#   RESEARCH_PROVIDER=google  -> RESEARCH_API_KEY (Custom Search JSON API key)
#                                + RESEARCH_GOOGLE_CX (Programmable Search engine id)
#                                https://developers.google.com/custom-search
# Powers the Research page: search, source collection, clustering, signals.
# Official/licensed APIs only, no scraping. Read on the server only.
# The app works without this; Research shows a clear "not configured" state.
# ─────────────────────────────────────────────────────────────────────────────
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
RESEARCH_GOOGLE_CX=

# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn — official OAuth app credentials only (optional, boundary only).
# The app never stores a user's LinkedIn password or session cookies and never
# performs unofficial automation. Publishing happens only through the supported
# official API when the required permissions are granted.
# ─────────────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/integrations/linkedin/callback

# ─────────────────────────────────────────────────────────────────────────────
# Email provider — OAuth app credentials only (optional, boundary only).
#   EMAIL_PROVIDER = gmail | microsoft
# For drafting and, with explicit user approval, sending follow-ups.
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/email/callback

# ─────────────────────────────────────────────────────────────────────────────
# Company / people data provider (optional, boundary only — not implemented).
# For legitimate company and professional-contact information from a licensed
# data source. No scraping.
# ─────────────────────────────────────────────────────────────────────────────
COMPANY_DATA_PROVIDER=
COMPANY_DATA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Calendar — OAuth app credentials only (optional, boundary only).
#   CALENDAR_PROVIDER = google | microsoft
# ─────────────────────────────────────────────────────────────────────────────
CALENDAR_PROVIDER=
CALENDAR_OAUTH_CLIENT_ID=
CALENDAR_OAUTH_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/calendar/callback
