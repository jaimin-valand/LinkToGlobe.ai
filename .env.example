# LinkToGlobe — environment template.
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# Every value here is a placeholder. Do not paste real secrets into this file.

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# Node environment: development | test | production
NODE_ENV=development

# Public base URL of the app. Safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Database (Phase 1) — PostgreSQL connection string.
# Optional in Step 1; the app builds and runs without it.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/linktoglobe?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# The following are NOT used in Step 1. They are listed so contributors know
# where secrets will live. Leave blank until the relevant phase.
# ─────────────────────────────────────────────────────────────────────────────

# Auth (Phase 1)
AUTH_SECRET=

# AI provider layer (Phase 2) — server-side only, never exposed to the client.
AI_PROVIDER=
AI_API_KEY=

# Publishing integrations (Phase 4) — OAuth app credentials only.
# LinkToGlobe never stores end-user platform passwords or session cookies.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
