# LinkToGlobe — environment template.
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# Every value here is a placeholder. Do not paste real secrets into this file.

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# Node environment: development | test | production
NODE_ENV=development

# Public base URL of the app. Safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Database — PostgreSQL. Required.
# The default matches docker-compose.yml (`docker compose up -d`).
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://linktoglobe:linktoglobe@localhost:5432/linktoglobe?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# Auth — secret used to sign session cookies. Required.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-a-64-char-hex-string

# Seed account created by `npm run db:seed` (development convenience only).
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me-locally

# ─────────────────────────────────────────────────────────────────────────────
# AI provider layer (optional).
# provider = manual  -> no API calls; you write drafts yourself (default).
# provider = anthropic -> uses the Anthropic API for idea/hook/draft assistance
#                         and AI-assisted quality review. Server-side only.
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=manual
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────────────────────
# External publishing integrations — NOT implemented.
# LinkToGlobe never stores end-user platform passwords or session cookies.
# When built, these hold OAuth *app* credentials only. Leave blank.
# ─────────────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
