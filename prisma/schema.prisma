// LinkToGlobe data model.
//
// The content lifecycle (DRAFT -> QUALITY_CHECK -> USER_APPROVAL -> PUBLISHED,
// with REJECTED as an off-ramp) is enforced in code by src/server/content/state.ts
// and mirrors APPROVAL_LIFECYCLE in src/lib/pipeline.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  EDITOR
}

/// Where a piece of content sits in the publishing lifecycle.
enum ContentState {
  DRAFT
  QUALITY_CHECK
  USER_APPROVAL
  PUBLISHED
  REJECTED
}

/// Lifecycle of one research run against a provider.
enum ResearchRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// The kind of thing a signal points at.
enum SignalKind {
  CHANGE // something moved or was announced
  RECURRING // the same point keeps coming up
  UNUSUAL // an outlier vs the rest of the coverage
  RISING // gaining attention (volume / recency)
  GAP // something the coverage seems to be missing
}

/// Whether a signal restates a source or is our own inference from several.
enum EvidenceKind {
  DIRECT
  INFERENCE
}

enum IdeaStatus {
  NEW
  IN_PROGRESS
  ARCHIVED
}

/// Opening-line strategy a hook candidate uses. Assigned deterministically.
enum HookStrategy {
  QUESTION // opens with a pointed question
  CONTRARIAN // challenges a common assumption
  STORY // starts mid-scene or first person
  STAT // leads with a concrete figure
  HOWTO // promises a method or steps
  DIRECT // plain statement of the takeaway
}

/// Where a hook candidate came from.
enum HookSource {
  AI // drafted by the configured AI provider (advisory)
  MANUAL // written by the user
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  name           String?
  role           UserRole          @default(OWNER)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  knowledge      KnowledgeProfile?
  drafts         ContentDraft[]
  activity       ActivityLog[]
  researchRuns   ResearchRun[]
  sources        ResearchSource[]
  clusters       StoryCluster[]
  signals        Signal[]
  ideas          Idea[]
  hookLabs       HookLab[]
  hookCandidates HookCandidate[]
}

/// The user's professional context — the "USER KNOWLEDGE" pipeline stage.
model KnowledgeProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline  String   @default("")
  expertise String   @default("") @db.Text
  audience  String   @default("")
  tone      String   @default("")
  topics    String[] @default([])
  sources   String   @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single unit of content moving through the pipeline.
model ContentDraft {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  hook            String          @default("") @db.Text
  body            String          @default("") @db.Text
  sourceNotes     String          @default("") @db.Text
  state           ContentState    @default(DRAFT)
  rejectionReason String?         @db.Text
  originIdeaId    String?         @unique
  originIdea      Idea?           @relation(fields: [originIdeaId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  submittedAt     DateTime?
  approvedAt      DateTime?
  publishedAt     DateTime?
  qualityReports  QualityReport[]
  activity        ActivityLog[]

  @@index([userId])
  @@index([state])
}

/// Result of running the quality engine against a draft.
model QualityReport {
  id        String       @id @default(cuid())
  draftId   String
  draft     ContentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  passed    Boolean
  score     Int
  checks    Json
  createdAt DateTime     @default(now())

  @@index([draftId])
}

/// Append-only audit trail for lifecycle actions (see SECURITY.md).
model ActivityLog {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftId   String?
  draft     ContentDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  action    String
  detail    Json?
  createdAt DateTime      @default(now())

  @@index([draftId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Research intelligence
//
//   query -> ResearchRun -> ResearchSource(s) -> StoryCluster(s) -> Signal(s)
//   -> (relevance to KnowledgeProfile) -> opportunity view -> saved Idea
//
// Everything is user-owned. See src/server/research/.
// ─────────────────────────────────────────────────────────────────────────────

/// One search against a research provider, plus the derived analysis.
model ResearchRun {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  query        String            @db.Text
  provider     String
  status       ResearchRunStatus @default(PENDING)
  error        String?           @db.Text
  sourceCount  Int               @default(0)
  clusterCount Int               @default(0)
  signalCount  Int               @default(0)
  createdAt    DateTime          @default(now())
  completedAt  DateTime?
  sources      ResearchSource[]
  clusters     StoryCluster[]
  signals      Signal[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

/// A normalised source returned by a provider for a run.
model ResearchSource {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId            String
  run              ResearchRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  clusterId        String?
  cluster          StoryCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  canonicalUrl     String        @db.Text
  urlHash          String
  title            String        @db.Text
  publisher        String?
  author           String?
  publishedAt      DateTime?
  excerpt          String        @default("") @db.Text
  provider         String
  providerSourceId String?
  relevanceScore   Int? // 0-100 relevance of this source to the user
  relevanceReasons Json?
  metadata         Json?
  retrievedAt      DateTime      @default(now())
  createdAt        DateTime      @default(now())

  @@unique([runId, urlHash]) // dedupe within a run by canonical URL
  @@index([userId, createdAt])
  @@index([runId])
  @@index([clusterId])
}

/// A group of sources that appear to cover the same underlying story.
model StoryCluster {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId     String
  run       ResearchRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  title     String           @db.Text
  summary   String           @default("") @db.Text
  size      Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sources   ResearchSource[]
  signals   Signal[]

  @@index([userId])
  @@index([runId])
}

/// An interpreted observation about the coverage, traceable to its sources.
model Signal {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId            String
  run              ResearchRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  clusterId        String?
  cluster          StoryCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  kind             SignalKind
  evidenceKind     EvidenceKind  @default(DIRECT)
  summary          String        @db.Text
  detail           String        @default("") @db.Text
  sourceIds        String[]      @default([]) // ResearchSource ids that support this
  relevanceScore   Int? // 0-100 relevance to the user's knowledge
  relevanceReasons Json?
  savedIdeaId      String?       @unique
  savedIdea        Idea?         @relation(fields: [savedIdeaId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())

  @@index([userId])
  @@index([runId])
  @@index([clusterId])
}

/// A content idea, most often saved from a research signal.
model Idea {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String        @db.Text
  angle      String        @default("") @db.Text
  notes      String        @default("") @db.Text
  sourceUrls String[]      @default([])
  status     IdeaStatus    @default(NEW)
  origin     String        @default("research") // "research" | "manual"
  signal     Signal?
  draft      ContentDraft? // set when the idea has been turned into a draft
  hookLab    HookLab? // the Hook Lab workspace for this idea
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Hook Lab
//
//   Idea -> HookLab -> HookCandidate(s) -> selected hook -> ContentDraft.hook
//
// Candidates are generated by AI (advisory) or written by the user, then scored
// by deterministic checks (relevance, clarity, differentiation). See
// src/server/hooks/.
// ─────────────────────────────────────────────────────────────────────────────

/// A workspace for shaping the opening hook of one idea. One per idea.
model HookLab {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId              String          @unique
  idea                Idea            @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  candidates          HookCandidate[] @relation("LabCandidates")
  selectedCandidateId String?         @unique
  selectedCandidate   HookCandidate?  @relation("LabSelection", fields: [selectedCandidateId], references: [id], onDelete: SetNull)
  lastGeneratedAt     DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId])
}

/// One candidate opening line, with its deterministic scores frozen at insert.
model HookCandidate {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  labId            String
  lab              HookLab      @relation("LabCandidates", fields: [labId], references: [id], onDelete: Cascade)
  text             String       @db.Text
  strategy         HookStrategy
  source           HookSource
  relevanceScore   Int // 0-100 overlap with the idea
  relevanceOverlap String[]     @default([])
  clarityScore     Int // 0-100 readability
  clarityGrade     String // "clear" | "okay" | "dense"
  clarityNotes     Json
  wordCount        Int
  warnings         String[]     @default([]) // e.g. "unverified-figure", "too-long"
  selectedInLab    HookLab?     @relation("LabSelection")
  createdAt        DateTime     @default(now())

  @@index([labId])
  @@index([userId])
}
